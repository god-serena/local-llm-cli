#!/usr/bin/env bash
# Run Swift 1.5 Qwen 3.8 27B GSQ-RCO (IQ3_XXS MTP) via CLI agent harness or llama server
HARNESS_BIN="${HARNESS_BIN:-${PI_BIN:-$HOME/.volta/bin/pi}}"
SERVER_URL="${LLAMA_SERVER_URL:-http://localhost:8080}"
MODELS_DIR="${LLAMA_MODELS_DIR:-$HOME/llama-models}"
MODEL_PATH="${MODELS_DIR}/Swift-1.5-Qwen3.8-27B-GSQ-RCO-IQ3_XXS-mtp.gguf"
MODEL_ID="qwen-27b-swift-gsq"

SYSTEM_PROMPT=""
PROMPT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--system)
      SYSTEM_PROMPT="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: qwen-27b-swift-gsq [-s \"<system_prompt>\"] \"<prompt>\""
      echo "       echo \"<prompt>\" | qwen-27b-swift-gsq"
      exit 0
      ;;
    *)
      if [ -z "$PROMPT" ]; then
        PROMPT="$1"
      else
        PROMPT="$PROMPT $1"
      fi
      shift
      ;;
  esac
done

if [ -z "$PROMPT" ] && [ ! -t 0 ]; then
  PROMPT=$(cat)
fi

if [ -z "$PROMPT" ]; then
  echo "Usage: qwen-27b-swift-gsq [-s \"<system_prompt>\"] \"<prompt>\""
  exit 1
fi

if [ -x "$HARNESS_BIN" ]; then
    EXTRA_HARNESS_ARGS=()
    if [ -n "$SYSTEM_PROMPT" ]; then
        EXTRA_HARNESS_ARGS+=(--system "$SYSTEM_PROMPT")
    fi
    "$HARNESS_BIN" --provider llama-cpp --model "$MODEL_ID" "${EXTRA_HARNESS_ARGS[@]}" -p "$PROMPT" 2>/dev/null || {
      if [ -n "$SYSTEM_PROMPT" ]; then
          MESSAGES="[{\"role\": \"system\", \"content\": $(jq -n --arg s "$SYSTEM_PROMPT" '$s')}, {\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]"
      else
          MESSAGES="[{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]"
      fi
      curl -s "${SERVER_URL}/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "{
          \"model\": \"$MODEL_PATH\",
          \"temperature\": 0.0,
          \"messages\": $MESSAGES
        }" | jq -r '.choices[0].message.content // .error.message'
    }
else
    if [ -n "$SYSTEM_PROMPT" ]; then
        MESSAGES="[{\"role\": \"system\", \"content\": $(jq -n --arg s "$SYSTEM_PROMPT" '$s')}, {\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]"
    else
        MESSAGES="[{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]"
    fi
    curl -s "${SERVER_URL}/v1/chat/completions" \
      -H "Content-Type: application/json" \
      -d "{
        \"model\": \"$MODEL_PATH\",
        \"temperature\": 0.0,
        \"messages\": $MESSAGES
      }" | jq -r '.choices[0].message.content // .error.message'
fi
