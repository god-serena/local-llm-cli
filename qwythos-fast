#!/usr/bin/env bash
# Qwythos 9B Fast Subagent Launcher (Q5_K_M Quantization)
# Target model: $LLAMA_MODELS_DIR/Emperio_Qwythos-9B-v2-MTP-Q5_K_M.gguf
# Server: ${LLAMA_SERVER_URL:-http://localhost:8080}/v1

HARNESS_BIN="${HARNESS_BIN:-${PI_BIN:-$HOME/.volta/bin/pi}}"
MODELS_DIR="${LLAMA_MODELS_DIR:-$HOME/llama-models}"
SERVER_URL="${LLAMA_SERVER_URL:-http://localhost:8080}"
MODEL_PATH="${MODELS_DIR}/Emperio_Qwythos-9B-v2-MTP-Q5_K_M.gguf"
DEFAULT_SYSTEM="You are Qwythos Coder, a fast execution subagent. Output concise, production-ready code or technical answers with no unnecessary fluff."

SYSTEM_PROMPT="$DEFAULT_SYSTEM"
PROMPT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--system)
      SYSTEM_PROMPT="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: qwythos-fast [-s \"<system_prompt>\"] \"<prompt>\""
      echo "       echo \"<prompt>\" | qwythos-fast"
      exit 0
      ;;
    *)
      if [ -z "$PROMPT" ]; then
        PROMPT="$1"
      else
        PROMPT="$PROMPT $1"
      fi
      shift
      ;;
  esac
done

if [ -z "$PROMPT" ] && [ ! -t 0 ]; then
  PROMPT=$(cat)
fi

if [ -z "$PROMPT" ]; then
  echo "Usage: qwythos-fast [-s \"<system_prompt>\"] \"<prompt>\""
  exit 1
fi

if [ -x "$HARNESS_BIN" ]; then
    "$HARNESS_BIN" --provider llama-cpp --model "qwythos-fast" --system "$SYSTEM_PROMPT" -p "$PROMPT" 2>/dev/null || {
      curl -s "${SERVER_URL}/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d "{
          \"model\": \"$MODEL_PATH\",
          \"temperature\": 0.1,
          \"messages\": [
            {\"role\": \"system\", \"content\": $(jq -n --arg s "$SYSTEM_PROMPT" '$s')},
            {\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}
          ]
        }" | jq -r '.choices[0].message.content // .error.message'
    }
else
    curl -s "${SERVER_URL}/v1/chat/completions" \
      -H "Content-Type: application/json" \
      -d "{
        \"model\": \"$MODEL_PATH\",
        \"temperature\": 0.1,
        \"messages\": [
          {\"role\": \"system\", \"content\": $(jq -n --arg s "$SYSTEM_PROMPT" '$s')},
          {\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}
        ]
      }" | jq -r '.choices[0].message.content // .error.message'
fi
