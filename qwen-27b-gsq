#!/usr/bin/env bash
# Run Qwen 3.8 27B GSQ-RCO (IQ3_XXS MTP) via CLI agent harness or llama server
HARNESS_BIN="${HARNESS_BIN:-${PI_BIN:-$HOME/.volta/bin/pi}}"
SERVER_URL="${LLAMA_SERVER_URL:-http://localhost:8080}"
MODELS_DIR="${LLAMA_MODELS_DIR:-$HOME/llama-models}"
MODEL_PATH="${MODELS_DIR}/ISTA-DASLab_Qwen3.8-27B-GSQ-RCO-IQ3_XXS-mtp.gguf"
MODEL_ID="qwen-27b-gsq"

SYSTEM_PROMPT=""
PROMPT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--system)
      SYSTEM_PROMPT="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: qwen-27b-gsq [-s \"<system_prompt>\"] \"<prompt>\""
      echo "       echo \"<prompt>\" | qwen-27b-gsq"
      exit 0
      ;;
    *)
      if [ -z "$PROMPT" ]; then
        PROMPT="$1"
      else
        PROMPT="$PROMPT $1"
      fi
      shift
      ;;
  esac
done

if [ -z "$PROMPT" ] && [ ! -t 0 ] && read -t 0; then
  PROMPT=$(cat)
fi

# Ensure non-interactive execution: redirect stdin to /dev/null so neither the script nor subcommands can wait for input
exec < /dev/null

if [ -z "$PROMPT" ]; then
  echo "Usage: qwen-27b-gsq [-s \"<system_prompt>\"] \"<prompt>\""
  exit 1
fi

if [ -x "$HARNESS_BIN" ]; then
    EXTRA_HARNESS_ARGS=()
    if [ -n "$SYSTEM_PROMPT" ]; then
        EXTRA_HARNESS_ARGS+=(--system "$SYSTEM_PROMPT")
    fi
    "$HARNESS_BIN" --provider llama-cpp --model "$MODEL_ID" "${EXTRA_HARNESS_ARGS[@]}" -p "$PROMPT" < /dev/null 2>/dev/null && exit 0
fi

if [ -n "$SYSTEM_PROMPT" ]; then
    MESSAGES="[{\"role\": \"system\", \"content\": $(jq -n --arg s "$SYSTEM_PROMPT" '$s')}, {\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]"
else
    MESSAGES="[{\"role\": \"user\", \"content\": $(jq -n --arg p "$PROMPT" '$p')}]"
fi

curl -s "${SERVER_URL}/v1/chat/completions" \
  -H "Content-Type: application/json" \
  -d "{
    \"model\": \"$MODEL_PATH\",
    \"temperature\": 0.1,
    \"messages\": $MESSAGES
  }" | jq -r '.choices[0].message.content // .error.message'
