#!/usr/bin/env bash
# Swift 1.5 Qwen 3.8 27B GSQ-RCO Llama Server Launcher
# Serves local Swift-1.5-Qwen3.8-27B-GSQ-RCO-IQ3_XXS-mtp.gguf on http://0.0.0.0:8080
#
# Environment Variables (with sensible defaults):
#   LLAMA_BIN        - Path to llama binary (default: $HOME/.local/bin/llama)
#   LLAMA_MODELS_DIR - Path to GGUF models folder (default: $HOME/llama-models)
#   LLAMA_PORT       - Server port (default: 8080)
#   LLAMA_HOST       - Server host IP (default: 0.0.0.0)

LLAMA_BIN="${LLAMA_BIN:-$HOME/.local/bin/llama}"
MODELS_DIR="${LLAMA_MODELS_DIR:-$HOME/llama-models}"
MODEL_PATH="${MODELS_DIR}/Swift-1.5-Qwen3.8-27B-GSQ-RCO-IQ3_XXS-mtp.gguf"

MODE="mtp"
PORT="${LLAMA_PORT:-8080}"
HOST="${LLAMA_HOST:-0.0.0.0}"
CTX_SIZE="32768"
PARALLEL="1"
CACHE_RAM="${LLAMA_CACHE_RAM:-8192}"

usage() {
    echo "Usage: serve-qwen-27b-swift-gsq [mtp|nomtp] [--max-ctx] [--max-cache] [--cache-ram 8192] [--port 8080] [--ctx 32768] [--parallel 1]"
    echo ""
    echo "Options:"
    echo "  mtp (default) -> Built-in MTP speculative decoding"
    echo "  nomtp         -> Standard generation without speculative decoding"
    echo "  --max-ctx     -> Use safe high-context ceiling (65,536 / 64k, 100% GPU VRAM safe)"
    echo "  --max-cache   -> Expand host RAM prompt cache to 12 GB (12,288 MiB, default: 8,192 MiB)"
    echo "  --cache-ram   -> Custom host RAM prompt cache size in MiB"
    echo ""
    exit "${1:-1}"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        mtp|fast)
            MODE="mtp"
            shift
            ;;
        nomtp|no-mtp|standard)
            MODE="nomtp"
            shift
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        --ctx)
            CTX_SIZE="$2"
            shift 2
            ;;
        --max-ctx|--max-context|max-ctx)
            CTX_SIZE="65536"
            shift
            ;;
        --max-cache|--max-cache-ram)
            CACHE_RAM="12288"
            shift
            ;;
        --cache-ram)
            CACHE_RAM="$2"
            shift 2
            ;;
        --parallel)
            PARALLEL="$2"
            shift 2
            ;;
        -h|--help)
            usage 0
            ;;
        *)
            usage
            ;;
    esac
done

if [ "$MODE" = "mtp" ]; then
    SPEC_ARGS=(
        --spec-type draft-mtp
        --spec-draft-n-max 3
        --spec-draft-p-min 0.05
        --spec-draft-p-split 0.05
        --cache-type-k-draft q4_0
        --cache-type-v-draft q4_0
    )
    echo "Starting Swift 1.5 Qwen 3.8 27B GSQ-RCO (IQ3_XXS with Tuned MTP) on http://$HOST:$PORT..."
else
    SPEC_ARGS=()
    echo "Starting Swift 1.5 Qwen 3.8 27B GSQ-RCO (IQ3_XXS Standard) on http://$HOST:$PORT..."
fi

exec "$LLAMA_BIN" server \
  --model "$MODEL_PATH" \
  --n-gpu-layers 99 \
  --ctx-size "$CTX_SIZE" \
  --parallel "$PARALLEL" \
  --cont-batching \
  --batch-size 2048 \
  --ubatch-size 2048 \
  "${SPEC_ARGS[@]}" \
  --cache-type-k q8_0 \
  --cache-type-v q4_0 \
  --flash-attn on \
  --cache-ram "$CACHE_RAM" \
  --metrics \
  --port "$PORT" \
  --host "$HOST"
